{%- unless request.page_type == 'index' -%}
<nav class="breadcrumbs" aria-label="Sayfa yolu">
  <ol>
    <li><a href="{{ routes.root_url }}">Ana sayfa</a></li>
    {%- if request.page_type == 'collection' -%}
      <li><a href="{{ routes.collections_url }}">Koleksiyonlar</a></li>
      <li><span aria-current="page">{{ collection.title }}</span></li>
    {%- elsif request.page_type == 'list-collections' -%}
      <li><span aria-current="page">Koleksiyonlar</span></li>
    {%- elsif request.page_type == 'product' -%}
      {%- assign crumb_collection = collection -%}
      {%- if crumb_collection == blank -%}
        {%- for candidate in product.collections -%}
          {%- if crumb_collection == blank and candidate.handle != 'frontpage' -%}
            {%- assign crumb_collection = candidate -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if crumb_collection != blank -%}
        <li><a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a></li>
      {%- endif -%}
      <li><span aria-current="page">{{ product.title }}</span></li>
    {%- elsif request.page_type == 'page' -%}
      <li><span aria-current="page">{{ page.title }}</span></li>
    {%- elsif request.page_type == 'blog' -%}
      <li><span aria-current="page">{{ blog.title }}</span></li>
    {%- elsif request.page_type == 'article' -%}
      <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
      <li><span aria-current="page">{{ article.title }}</span></li>
    {%- elsif request.page_type == 'search' -%}
      <li><span aria-current="page">Arama</span></li>
    {%- endif -%}
  </ol>
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana sayfa",
      "item": {{ request.origin | append: routes.root_url | json }}
    }
    {%- if request.page_type == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "Koleksiyonlar",
      "item": {{ request.origin | append: routes.collections_url | json }}
    },{
      "@type": "ListItem",
      "position": 3,
      "name": {{ collection.title | json }},
      "item": {{ request.origin | append: collection.url | json }}
    }
    {%- elsif request.page_type == 'product' -%}
      {%- if crumb_collection != blank -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ crumb_collection.title | json }},
      "item": {{ request.origin | append: crumb_collection.url | json }}
    },{
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ request.origin | append: product.url | json }}
    }
      {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ request.origin | append: product.url | json }}
    }
      {%- endif -%}
    {%- elsif request.page_type == 'list-collections' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "Koleksiyonlar",
      "item": {{ request.origin | append: routes.collections_url | json }}
    }
    {%- elsif request.page_type == 'page' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ page.title | json }},
      "item": {{ request.origin | append: page.url | json }}
    }
    {%- elsif request.page_type == 'blog' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ request.origin | append: blog.url | json }}
    }
    {%- elsif request.page_type == 'article' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ request.origin | append: blog.url | json }}
    },{
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": {{ request.origin | append: article.url | json }}
    }
    {%- endif -%}
  ]
}
</script>
{%- endunless -%}
