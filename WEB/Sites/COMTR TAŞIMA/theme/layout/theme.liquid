<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#F4EFE3">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    {%- liquid
      assign seo_hidden = false
      if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == '404'
        assign seo_hidden = true
      endif
      if request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' or request.page_type == 'customers/activate_account' or request.page_type == 'customers/reset_password'
        assign seo_hidden = true
      endif
      if request.page_type == 'collection' and collection.sort_by != blank and collection.sort_by != collection.default_sort_by
        assign seo_hidden = true
      endif
      if current_tags != blank
        assign seo_hidden = true
      endif
      assign seo_description = page_description
      if request.page_type == 'index'
        assign seo_description = 'Sümen takımı modelleri: deri, kristal ve lüks setler. Parça sayısı, ölçü ve kişiselleştirme bilgisiyle karşılaştırın. Makro Ofis üretimi.'
      elsif seo_description == blank and request.page_type == 'blog'
        assign seo_description = 'Sümen takımı seçimi, deri-kristal farkı, isimlik siparişi ve masa düzeni üzerine rehber yazılar.'
      elsif seo_description == blank and request.page_type == 'list-collections'
        assign seo_description = 'Sümen takımları, masa isimlikleri, makam panoları ve otel ekipmanlarını kullanım yerine göre inceleyin.'
      endif
    -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if seo_hidden -%}
      <meta name="robots" content="noindex, nofollow">
    {%- endif -%}

    <title>
      {%- if request.page_type == 'index' -%}
        Sümen Takımı Modelleri ve Masaüstü Setleri | Sümen Takımı
      {%- else -%}
        {{ page_title | remove: ' — Sümen Takımı TR' | remove: ' | Sümen Takımı TR' -}}
        {%- if current_tags %} — {{ current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} — {{ 'general.pagination.page' | t: page: current_page }}{% endif -%}
        {%- unless page_title contains 'Sümen Takımı' %} — Sümen Takımı{% endunless -%}
      {%- endif -%}
    </title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | escape }}">
    {%- endif -%}

    <meta property="og:site_name" content="Sümen Takımı">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:locale" content="tr_TR">
    {%- if request.page_type == 'index' -%}
      <meta property="og:title" content="Sümen Takımı Modelleri ve Masaüstü Setleri | Sümen Takımı">
    {%- else -%}
      <meta property="og:title" content="{{ page_title | remove: ' — Sümen Takımı TR' | remove: ' | Sümen Takımı TR' | escape }}">
    {%- endif -%}
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    {%- if seo_description != blank -%}
      <meta property="og:description" content="{{ seo_description | escape }}">
    {%- endif -%}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    <meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">

    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {%- if request.page_type == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ request.origin | append: '/#organization' | json }},
          "name": "Sümen Takımı",
          "url": {{ request.origin | json }}{% if settings.contact_email != blank %},
          "email": {{ settings.contact_email | json }}{% endif %}{% if settings.contact_phone != blank %},
          "telephone": {{ settings.contact_phone | json }}{% endif %}{% if settings.contact_address != blank %},
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ settings.contact_address | json }},
            "addressCountry": "TR"
          }{% endif %}
        },
        {
          "@type": "WebSite",
          "@id": {{ request.origin | append: '/#website' | json }},
          "url": {{ request.origin | json }},
          "name": "Sümen Takımı",
          "inLanguage": "tr-TR",
          "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} }
        }
      ]
    }
    </script>
    {%- endif -%}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% section 'site-header' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'site-footer' %}
  </body>
</html>
