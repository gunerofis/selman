{% javascript %}
  const form = document.querySelector('[data-catalog-filters]');
  const grid = document.querySelector('[data-catalog-grid]');
  const rail = document.querySelector('[data-filter-rail]');
  const backdrop = document.querySelector('[data-filter-backdrop]');
  const chips = document.querySelector('[data-filter-chips]');
  const countEl = document.querySelector('[data-catalog-count]');
  const emptyEl = document.querySelector('[data-catalog-empty]');
  const clearBtn = document.querySelector('[data-filter-clear]');
  const badge = document.querySelector('[data-filter-badge]');
  const cards = grid ? [...grid.querySelectorAll('.catalog-card')] : [];

  const readState = () => {
    if (!form) return {};
    const data = new FormData(form);
    return {
      pieces: data.get('pieces') || '',
      material: data.get('material') || '',
      personal: data.get('personal') === '1',
      flag: data.get('flag') === '1',
      shelf: data.get('shelf') === '1',
      price: data.get('price') || ''
    };
  };

  const priceMatch = (card, range) => {
    if (!range) return true;
    const price = Number(card.getAttribute('data-price') || 0);
    const bits = range.split('-');
    const min = Number(bits[0] || 0);
    const max = bits[1] === '' || bits[1] == null ? Infinity : Number(bits[1]);
    return price >= min && price < max;
  };

  const pieceValue = (card) => String(card.getAttribute('data-pieces') || '').replace(/\D/g, '');

  const cardMatches = (card, state) => {
    if (state.pieces && pieceValue(card) !== String(state.pieces)) return false;
    if (state.material && card.getAttribute('data-material') !== state.material) return false;
    if (state.personal && card.getAttribute('data-personal') !== '1') return false;
    if (state.flag && card.getAttribute('data-flag') !== '1') return false;
    if (state.shelf && card.getAttribute('data-shelf') !== '1') return false;
    if (!priceMatch(card, state.price)) return false;
    return true;
  };

  const labels = {
    pieces: (v) => v + ' parça',
    material: (v) => v,
    personal: () => 'Kişiselleştirilebilir',
    flag: () => 'Masa bayraklı',
    shelf: () => 'Evrak rafı',
    price: (v) => v === '0-200000' ? '2000 TL altı' : v === '200000-400000' ? '2000–4000 TL' : '4000 TL üstü'
  };

  const applyFilters = () => {
    if (!form || !grid) return;
    const state = readState();
    let visible = 0;
    cards.forEach((card) => {
      const show = cardMatches(card, state);
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (countEl) countEl.textContent = visible + ' ürün';
    if (emptyEl) emptyEl.hidden = visible > 0 || cards.length === 0;
    const active = [];
    if (state.pieces) active.push({ key: 'pieces', label: labels.pieces(state.pieces) });
    if (state.material) active.push({ key: 'material', label: labels.material(state.material) });
    if (state.personal) active.push({ key: 'personal', label: labels.personal() });
    if (state.flag) active.push({ key: 'flag', label: labels.flag() });
    if (state.shelf) active.push({ key: 'shelf', label: labels.shelf() });
    if (state.price) active.push({ key: 'price', label: labels.price(state.price) });
    if (chips) {
      chips.replaceChildren();
      active.forEach((item) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'filter-chip';
        chip.textContent = item.label;
        chip.setAttribute('aria-label', item.label + ' filtresini kaldır');
        chip.addEventListener('click', () => {
          const input = form.querySelector('[name="' + item.key + '"][value=""]') || form.querySelector('[name="' + item.key + '"]');
          if (input && input.type === 'checkbox') input.checked = false;
          else if (input) input.checked = true;
          applyFilters();
        });
        chips.append(chip);
      });
      chips.hidden = active.length === 0;
    }
    if (clearBtn) clearBtn.hidden = active.length === 0;
    if (badge) badge.textContent = active.length ? ' (' + active.length + ')' : '';
    form.querySelectorAll('.filter-option input').forEach((input) => {
      if (input.value === '' || (input.type === 'checkbox' && !input.checked && !input.value)) {
        input.disabled = false;
        return;
      }
      const next = Object.assign({}, state);
      if (input.type === 'checkbox') next[input.name] = true;
      else next[input.name] = input.value;
      const any = cards.some((card) => cardMatches(card, next));
      input.disabled = !any && !input.checked;
    });
    form.querySelectorAll('[data-filter-group]').forEach((group) => {
      const key = group.getAttribute('data-filter-group');
      const present = cards.some((card) => {
        if (key === 'pieces') return Boolean(pieceValue(card));
        if (key === 'material') return Boolean(card.getAttribute('data-material'));
        if (key === 'feature') {
          return card.getAttribute('data-personal') === '1' || card.getAttribute('data-flag') === '1' || card.getAttribute('data-shelf') === '1';
        }
        return true;
      });
      group.hidden = !present;
    });
  };

  const closeRail = () => {
    rail?.classList.remove('is-open');
    if (backdrop) backdrop.hidden = true;
    document.body.classList.remove('filter-open');
  };

  document.querySelector('[data-filter-open]')?.addEventListener('click', () => {
    rail?.classList.add('is-open');
    if (backdrop) backdrop.hidden = false;
    document.body.classList.add('filter-open');
  });
  document.querySelector('[data-filter-close]')?.addEventListener('click', closeRail);
  backdrop?.addEventListener('click', closeRail);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeRail();
  });
  form?.addEventListener('change', applyFilters);
  form?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  clearBtn?.addEventListener('click', (event) => {
    event.preventDefault();
    form?.reset();
    applyFilters();
  });
  applyFilters();
{% endjavascript %}

