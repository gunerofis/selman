<section class="generic-page catalog-page">
  <header class="catalog-head">
    <div><p class="eyebrow">Koleksiyon</p><h1>{{ collection.title }}</h1></div>
    <div class="catalog-head__copy">{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% else %}<p>Çalışma alanınıza uygun masa üstü ürünlerini; malzeme, set içeriği ve kullanım biçimine göre karşılaştırın.</p>{% endif %}<span>{{ collection.products_count }} ürün</span></div>
  </header>
  {% liquid
    assign handle = collection.handle
    assign is_sumen_family = false
    if handle == 'sumen-takimi' or handle == 'deri-sumen-takimlari' or handle == 'luks-sumen-takimlari' or handle == 'kristal-sumen-takimlari' or handle contains 'parca-sumen'
      assign is_sumen_family = true
    endif
  %}
  {% paginate collection.products by 120 %}
  <div class="catalog-layout">
    <div class="filter-backdrop" data-filter-backdrop hidden></div>
    <aside class="filter-rail" data-filter-rail id="FilterRail">
      <div class="filter-rail__head">
        <h2>Filtrele</h2>
        <button type="button" class="dialog-close" data-filter-close aria-label="Filtreleri kapat"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"/></svg></button>
      </div>
      <form class="filter-form" data-catalog-filters>
        {% if is_sumen_family %}
        <fieldset class="filter-group" data-filter-group="pieces">
          <legend>Parça</legend>
          <label class="filter-option"><input type="radio" name="pieces" value="" checked> Tümü</label>
          <label class="filter-option"><input type="radio" name="pieces" value="6"> 6 parça</label>
          <label class="filter-option"><input type="radio" name="pieces" value="7"> 7 parça</label>
          <label class="filter-option"><input type="radio" name="pieces" value="9"> 9 parça</label>
          <label class="filter-option"><input type="radio" name="pieces" value="10"> 10 parça</label>
          <label class="filter-option"><input type="radio" name="pieces" value="11"> 11 parça</label>
          <label class="filter-option"><input type="radio" name="pieces" value="12"> 12 parça</label>
        </fieldset>
        {% endif %}
        <fieldset class="filter-group" data-filter-group="material">
          <legend>Malzeme</legend>
          <label class="filter-option"><input type="radio" name="material" value="" checked> Tümü</label>
          <label class="filter-option"><input type="radio" name="material" value="Deri"> Deri</label>
          <label class="filter-option"><input type="radio" name="material" value="Kristal"> Kristal</label>
        </fieldset>
        <fieldset class="filter-group" data-filter-group="feature">
          <legend>Özellik</legend>
          <label class="filter-option"><input type="checkbox" name="personal" value="1"> Kişiselleştirilebilir</label>
          <label class="filter-option"><input type="checkbox" name="flag" value="1"> Masa bayraklı</label>
          <label class="filter-option"><input type="checkbox" name="shelf" value="1"> Evrak rafı</label>
        </fieldset>
        <fieldset class="filter-group" data-filter-group="price">
          <legend>Fiyat</legend>
          <label class="filter-option"><input type="radio" name="price" value="" checked> Tümü</label>
          <label class="filter-option"><input type="radio" name="price" value="0-200000"> 2000 TL altı</label>
          <label class="filter-option"><input type="radio" name="price" value="200000-400000"> 2000–4000 TL</label>
          <label class="filter-option"><input type="radio" name="price" value="400000-"> 4000 TL üstü</label>
        </fieldset>
        <button type="reset" class="text-link filter-clear" data-filter-clear hidden>Filtreleri temizle</button>
      </form>
    </aside>
    <div class="catalog-main">
      <div class="catalog-toolbar">
        <button type="button" class="filter-open" data-filter-open aria-controls="FilterRail">
          Filtrele<span data-filter-badge></span>
        </button>
        <p class="catalog-count" data-catalog-count>{{ paginate.items }} ürün</p>
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        {% if collection.sort_options.size > 0 %}
          <form method="get" action="{{ collection.url }}" class="catalog-sort">
            <label for="SortBy">Sırala</label>
            <select name="sort_by" id="SortBy" onchange="this.form.submit()">
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
            <button class="visually-hidden" type="submit">Uygula</button>
          </form>
        {% endif %}
      </div>
      <div class="filter-chips" data-filter-chips hidden></div>
      <div class="catalog-grid home-board" data-catalog-grid>
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>Bu koleksiyona henüz ürün eklenmedi.</p>
        {% endfor %}
      </div>
      <p class="catalog-empty" data-catalog-empty hidden>Bu ölçütlere uyan ürün bu sayfada yok. Filtreleri temizleyin veya sonraki sayfaya bakın.</p>
      {% render 'pagination', paginate: paginate %}
    </div>
  </div>
  {% endpaginate %}
</section>

{% liquid
