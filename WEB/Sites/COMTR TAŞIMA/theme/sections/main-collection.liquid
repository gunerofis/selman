  if handle == 'deri-sumen-takimlari'
    assign fq1 = 'Deri sümen takımı nasıl temizlenir?'
    assign fa1 = 'Kuru veya hafif nemli yumuşak bez kullanılır. Ayrıntı deri sümen bakımı yazısındadır.'
    assign fq2 = 'Siyah mı kahve mi?'
    assign fa2 = 'Masa ve metal rengine göre seçilir. Renk rehberi yazısına bakın.'
    assign fq3 = 'Parça sayısı neyi değiştirir?'
    assign fa3 = 'Kaliteyi değil, masaya sığacak düzeni. 9–12 parça karşılaştırması yazısına bakın.'
    assign fq4 = 'İsimlik yazılır mı?'
    assign fa4 = 'Uygun setlerde evet. Kişiselleştirme SSS bölümüne bakın.'
  elsif handle == 'kristal-sumen-takimlari'
    assign fq1 = 'Kristal sümen günlük kullanıma uygun mu?'
    assign fa1 = 'Temsil masalarında öne çıkar; yoğun yazı için deri daha pratik olabilir.'
    assign fq2 = 'Sümen hediyeli ne demek?'
    assign fa2 = 'Kristal parça setine deri sümen eklenen modellerdir. Ürün set içeriğine bakın.'
    assign fq3 = 'Gold mu gümüş mü?'
    assign fa3 = 'Masadaki metal detayla uyum önemlidir.'
    assign fq4 = 'Nasıl temizlenir?'
    assign fa4 = 'Yumuşak bez; aşındırıcı kullanılmaz.'
  elsif handle == 'masa-ustu-isimlikler'
    assign fq1 = 'İsim ve unvan nasıl iletilir?'
    assign fa1 = 'Yazım onaylı ve Türkçe karakterli olmalı. İsimlik sipariş rehberine bakın.'
    assign fq2 = 'Logo basılır mı?'
    assign fa2 = 'Model uygunsa evet. Kurumsal logo süreci yazısına bakın.'
    assign fq3 = 'Ölçü nerede?'
    assign fa3 = 'Ürün açıklamasındaki ebat esastır; yoksa tahmin edilmez.'
    assign fq4 = 'Sümen takımıyla birlikte mi?'
    assign fa4 = 'Takımda isimlik varsa ayrı almaya gerek yoktur.'
  elsif handle == 'makam-panolari' or handle == 'kumasli-panolar' or handle == 'ataturk-resimli-makam-panolari'
    assign fq1 = 'Makam panosu ölçüsü nasıl seçilir?'
    assign fa1 = 'Duvar genişliği ve görüş mesafesine göre seçilir.'
    assign fq2 = 'Kumaşlı pano ayrı mıdır?'
    assign fa2 = 'Evet. Kumaşlı panolar ayrı koleksiyondadır.'
    assign fq3 = 'Atatürk görseli var mı?'
    assign fa3 = 'Atatürk resimli makam panoları koleksiyonunda yer alır.'
    assign fq4 = 'Montaj dahil mi?'
    assign fa4 = 'Duvar türü ve ağırlık siparişte netleşir.'
  elsif handle == 'deri-otel-ekipmanlari'
    assign fq1 = 'Toplu otel siparişi olur mu?'
    assign fa1 = 'Evet. Adet ve renk iletişimden yazılır.'
    assign fq2 = 'Peçetelik örneği var mı?'
    assign fa2 = 'Deri peçetelik ürün sayfasında incelenebilir.'
    assign fq3 = 'Logo uygulanır mı?'
    assign fa3 = 'Malzeme ve adet uygunsa uygulanır.'
    assign fq4 = 'Sümen takımı mıdır?'
    assign fa4 = 'Hayır; oda ve lobi ekipmanıdır.'
  else
    assign fq1 = 'Sümen takımı nedir?'
    assign fa1 = 'Çalışma masasının ana yazı yüzeyini ve masaüstü araçlarını aynı düzende tutan settir.'
    assign fq2 = '9, 10, 11, 12 parça farkı nedir?'
    assign fa2 = 'Parça sayısı masaya sığacak düzeni değiştirir; kalite ölçüsü değildir.'
    assign fq3 = 'Masa ölçüsü nasıl bakılır?'
    assign fa3 = 'Masa üstü yazı alanı ve kenar boşluğu ürün ölçüsüyle karşılaştırılır.'
    assign fq4 = 'Daha fazla soru?'
    assign fa4 = 'Sık sorulan sorular sayfasında 200 soruluk kullanıcı rehberi vardır.'
