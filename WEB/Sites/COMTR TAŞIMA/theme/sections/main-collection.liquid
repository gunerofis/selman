    assign g3t = 'Montaj'
    assign g3p = 'Duvara montaj için ağırlık ve sabitleme biçimini teslimattan önce sorun.'
  elsif handle == 'deri-otel-ekipmanlari'
    assign guide_title = 'Otel ekipmanını nasıl seçersiniz?'
    assign g1t = 'Ürün türü'
    assign g1p = 'Oda içi kutu, tepsi, peçetelik veya talimat gibi ürünü kullanım yerine göre seçin.'
    assign g2t = 'Toplu üretim'
    assign g2p = 'Adet, renk ve teslim süresini kurumsal siparişte birlikte netleştirin.'
    assign g3t = 'Kurumsal renk'
    assign g3p = 'Otel kimliğine uygun deri rengi ve logo uygulamasını numune üzerinden onaylayın.'
  elsif handle == 'sumen-takimi' or handle == 'luks-sumen-takimlari' or handle contains 'parca-sumen'
    assign guide_title = 'Parça sayısına göre sümen takımı seçimi'
    assign g1t = 'Masa ölçüsü'
    assign g1p = 'Dar masalarda 9–10 parça; geniş yönetici masalarında 11–12 parça daha dengeli durur.'
    assign g2t = 'Set içeriği'
    assign g2p = 'Kalemlik, evraklık, isimlik ve masa bayrağı ihtiyacını parça sayısıyla birlikte kontrol edin.'
    assign g3t = 'Tam set'
    assign g3p = 'Masa bayraklı ve full set modeller ayrı üründür; içerik değişince varyant değil ayrı model seçin.'
  else
    assign guide_title = 'Bu kategoride doğru ürünü nasıl seçersiniz?'
    assign g1t = 'Kullanım yeri'
    assign g1p = 'Ürünü masa, duvar veya oda içi kullanımına göre ayırın; sümen sorularını pano ve otel ürünlerine taşımayın.'
    assign g2t = 'Malzeme ve renk'
    assign g2p = 'Mevcut mobilya rengi ve metal detaylarla uyumu ürün görsellerinden kontrol edin.'
    assign g3t = 'Sipariş desteği'
    assign g3p = 'Ölçü, adet veya kişiselleştirme için iletişim sayfasından yazın.'
