{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katalog",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/app-assets/_next/static/*",
      "/media/*"
    ]
  }
}
