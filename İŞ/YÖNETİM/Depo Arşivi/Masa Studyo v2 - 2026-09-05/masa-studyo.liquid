{% comment %}Interactive desk studio. Product photography from the store. No order or cart mutation.{% endcomment %}
<style>
desk-studio{--ds-ink:#193d30;--ds-paper:#f4f0e7;--ds-line:#d5cfc2;display:block;color:var(--ds-ink);background:var(--ds-paper);font:400 13px/1.5 'Montserrat',sans-serif;isolation:isolate}desk-studio *{box-sizing:border-box}desk-studio [hidden]{display:none!important}desk-studio button,desk-studio input,desk-studio select{font:inherit}desk-studio button,desk-studio a{touch-action:manipulation}desk-studio button{color:inherit;cursor:pointer}desk-studio button:disabled{opacity:.4;cursor:default}desk-studio :focus-visible{outline:2px solid #193d30;outline-offset:4px}.ds-shell{max-width:1600px;margin:auto;display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.8fr);min-height:570px}.ds-intro{padding:70px 20px 70px clamp(24px,4.5vw,80px);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;z-index:2}.ds-intro h1{font:500 clamp(44px,5.3vw,78px)/1.03 'Cormorant Garamond',Georgia,serif;letter-spacing:-1.7px;margin:0 0 24px;max-width:390px}.ds-intro p{max-width:310px;margin:0 0 30px;line-height:1.8;color:#5a645b;font-size:14px}.ds-btn{min-height:44px;padding:12px 17px;border:1px solid var(--ds-line);background:transparent;border-radius:3px;display:inline-flex;align-items:center;justify-content:center;gap:9px;text-decoration:none;white-space:nowrap}.ds-btn svg{width:17px;height:17px;flex:none}.ds-primary{background:var(--ds-ink);border-color:var(--ds-ink);color:#fff!important}.ds-primary:hover{background:#285341}.ds-start{padding:16px 22px;min-height:54px}.ds-link{margin-top:18px;color:var(--ds-ink);text-underline-offset:5px;font-size:12px}.ds-hero-note{display:block;margin-top:33px;color:#677168;font-size:11px}.ds-workspace{min-width:0;position:relative;display:flex;flex-direction:column;justify-content:center;background:#eae4d9}.ds-toolbar{padding:14px 20px;border-bottom:1px solid var(--ds-line);display:flex;gap:8px;align-items:center;flex-wrap:wrap;background:var(--ds-paper)}.ds-toolbar strong{font:500 26px 'Cormorant Garamond',Georgia,s