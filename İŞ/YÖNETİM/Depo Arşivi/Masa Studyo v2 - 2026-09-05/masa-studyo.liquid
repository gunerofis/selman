/* Studio v2: page scrolling, bounded camera, narrow screens and focus visibility. */
desk-studio:not(.is-editing) .ds-viewport{overflow:hidden;overscroll-behavior:auto;touch-action:pan-y}
desk-studio:not(.is-editing) .ds-piece{touch-action:pan-y}
desk-studio.is-editing .ds-viewport{height:clamp(330px,48vw,590px);min-height:0;max-height:none;overflow:auto;overscroll-behavior:auto}
desk-studio.is-editing .ds-toolbar{position:sticky;top:0;z-index:150}
.ds-card img{mix-blend-mode:normal}.ds-zoom{position:static;align-self:flex-end;margin:6px 12px;flex:none}.ds-zoom button{min-width:44px;min-height:44px}
.ds-personal{border-top:1px solid var(--ds-line);margin-top:18px;padding-top:14px}.ds-personal h3,.ds-summary h3{font:500 25px 'Cormorant Garamond',Georgia,serif;margin:0 0 8px}.ds-personal .ds-field input,.ds-personal .ds-field select{font-size:14px}.ds-font-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}.ds-font-choice{min-height:54px;border:1px solid var(--ds-line);background:#fff8;padding:6px;overflow:hidden}.ds-font-choice[aria-pressed=true]{border:2px solid var(--ds-ink)}.ds-font-choice span{display:block;font-size:17px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-font-choice small{font:9px Montserrat,sans-serif}.ds-logo-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.ds-logo-preview{width:64px;height:44px;object-fit:contain}.ds-logo-actions input{max-width:100%;font-size:11px}.ds-personal-note,.ds-draft-status{font-size:10px;color:#5a685a}.ds-summary{margin-top:18px;padding-top:14px;border-top:1px solid var(--ds-line)}.ds-summary ul{padding-left:17px;font-size:11px}.ds-summary .ds-btn{white-space:normal;width:100%;margin-top:8px}.ds-dialog img{max-height:65dvh;object-fit:contain}.ds-title-overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.ds-caption{flex-wrap:wrap}.ds-toolbar [data-act=arrange]::after{content:''}
@media(max-width:650px){desk-studio.is-editing{overflow:hidden;padding-top:env(safe-area-inset-top,0px)}desk-studio.is-editing .ds-toolbar{display:grid;grid-template-columns:44px minmax(68px,1fr) 44px 44px;gap:5px;padding:8px;overflow:visible;flex-wrap:wrap}.ds-toolbar [data-act=exit]{font-size:10px;padding:4px}.ds-toolbar [data-act=undo] span{display:none}.ds-toolbar [data-act=export]{grid-column:1/-1;width:100%;margin:0;min-height:44px}.ds-toolbar .ds-btn{padding:7px;font-size:11px}.ds-toolbar strong{display:none}.is-editing .ds-workspace{flex:0 0 auto;max-height:65dvh}.is-editing .ds-viewport{height:clamp(165px,31dvh,285px);min-height:0!important;max-height:33dvh!important}.is-editing .ds-stage{min-width:100%}.is-editing .ds-zoom{margin:2px 8px}.is-editing .ds-caption{padding:3px 10px;font-size:8px;gap:4px}.is-editing .ds-caption>span:last-child{display:none}.is-editing .ds-status{padding:0 10px 5px;font-size:10px;line-height:1.3;min-height:18px}.is-editing .ds-panel{min-height:0;padding-bottom:calc(18px + env(safe-area-inset-bottom,0px));overscroll-behavior:contain}.ds-selection-fields{grid-template-columns:1fr}.ds-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.ds-color{width:44px;height:44px}.ds-font-choice{min-height:58px}.ds-dialog{max-width:94vw}.ds-dialog .ds-actions .ds-btn{min-height:44px}}


desk-studio.is-editing .ds-shell{height:min(820px,calc(100dvh - 24px));min-height:0}desk-studio.is-editing .ds-workspace{display:grid;grid-template-rows:auto minmax(0,1fr) auto auto auto;min-height:0}desk-studio.is-editing .ds-viewport{height:auto;min-height:0;isolation:isolate;z-index:0}desk-studio.is-editing .ds-panel{height:100%;max-height:100%}.ds-personal-preview{display:block}.ds-dialog img{max-height:58dvh}
@media(max-width:650px){desk-studio.is-editing .ds-shell{height:100%;display:flex}desk-studio.is-editing .ds-workspace{display:flex;max-height:65dvh;flex:none}desk-studio.is-editing .ds-viewport{height:clamp(165px,31dvh,285px);flex-shrink:1;width:100%}desk-studio.is-editing .ds-panel{height:auto;flex:1;max-height:none}.ds-zoom{z-index:auto}}

desk-studio.is-editing .ds-workspace{grid-template-columns:minmax(0,1fr);justify-content:stretch}.ds-zoom{justify-self:end}
</style>
<desk-studio data-version="2.0" id="DeskStudio-{{ section.id }}">
 <div class="ds-shell">
  <div class="ds-intro"><h1>Masanız.<br>Sizin imzanız.</h1><p>Parçaları seçin, renkleri deneyin.<br>Size ait bir masa oluşturun.</p><button class="ds-btn ds-primary ds-start" data-act="start">Masanı tasarla <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button><a class="ds-link" href="{{ routes.collections_url }}/sumen-takimi">Sümen takımlarını keşfet</a><span class="ds-hero-note">Gerçek ürünler. Size özel bir yerleşim.</span></div>
  <div class="ds-workspace">
   <div class="ds-toolbar ds-bar" role="toolbar" aria-label="Masa düzenleme araçları"><strong>Masa stüdyosu</strong><button class="ds-btn" data-act="exit" aria-label="Düzenleyiciyi kapat">Kapat</button><button class="ds-btn" data-act="arrange">Düzenle</button><button class="ds-btn" data-act="undo" aria-label="Geri al" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m8 4-5 5 5 5M3 9h10a7 7 0 0 1 0 14"/></svg><span>Geri al</span></button><button class="ds-btn" data-act="redo" aria-label="Yinele" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m16 4 5 5-5 5M21 9H11a7 7 0 0 0 0 14"/></svg></button><button class="ds-btn ds-primary ds-save" data-act="export">Görseli kaydet</button></div>
   <div class="ds-viewport"><div class="ds-stage"><canvas class="ds-backdrop" width="1200" height="800" aria-label="Ürünlerin yerleştirildiği açık meşe çalışma masası"></canvas><div class="ds-layer" role="group" aria-label="Masadaki parçalar"></div></div></div>
   <div class="ds-zoom ds-bar" aria-label="Yakınlaştırma"><button data-act="zoomout" aria-label="Uzaklaştır">−</button><button data-act="zoomin" aria-label="Yakınlaştır">+</button><button data-act="fit">Masaya sığdır</button></div>
   <div class="ds-caption"><span data-count>Başlangıç düzeni</span><span>Yerleşim önizlemesi · Ürün ölçekleri temsilidir.</span></div><div class="ds-status" role="status" aria-live="polite">Masanız hazırlanıyor…</div>
  </div>
  <aside class="ds-panel" aria-label="Ürün seçimi ve düzenleme">
   <div class="ds-selection" hidden><h3 data-selection-title></h3><small data-selection-description></small><div class="ds-selection-fields"><label class="ds-field"><span>Model</span><select data-model aria-label="Seçili parçanın modeli"></select></label><div class="ds-field"><span>Renk</span><div class="ds-colors"></div><div class="ds-color-label"></div></div></div><button class="ds-remove" data-act="remove">Parçayı kaldır</button></div>
   <div class="ds-panel-head"><h2>Masaya ekle</h2><small>Dokunarak seçin</small></div><div class="ds-grid"></div><p class="ds-help">Bir parçaya dokunarak renk ve modelini değiştirin. Tutup sürükleyerek yerleştirin.</p><div class="ds-pieces" aria-label="Masadaki parçaları seçin"></div><div class="ds-bottom"><button class="ds-btn" data-act="empty">Boş masayla başla</button><button class="ds-btn" data-act="starter">Başlangıç düzeni</button></div><div class="ds-personal"><h3>İsim ve logo</h3><p class="ds-personal-note">Yazınız ve logonuz masadaki isimliğe ve kaydedilen görsele uygulanır.</p><img data-personal-preview class="ds-personal-preview" width="400" height="200" alt="Kişiselleştirilmiş isimlik önizlemesi" style="width:100%;height:120px;object-fit:contain"><label class="ds-field"><span>Adınız ve soyadınız</span><input data-personal-name maxlength="60" autocomplete="off" placeholder="Adınız Soyadınız"></label><label class="ds-field"><span>Unvanınız</span><input data-personal-title maxlength="90" autocomplete="off" placeholder="Unvanınız"></label><div class="ds-field"><span>Yazı tipi · 8 Google Fonts</span><div class="ds-font-grid"><button class="ds-font-choice" data-font="Cormorant Garamond" aria-label="Cormorant Garamond yazı tipini seç" aria-pressed="true"><span style="font-family:'Cormorant Garamond',serif">Adınız Soyadınız</span><small>Cormorant Garamond</small></button><button class="ds-font-choice" data-font="Montserrat" aria-label="Montserrat yazı tipini seç" aria-pressed="false"><span style="font-family:'Montserrat',serif">Adınız Soyadınız</span><small>Montserrat</small></button><button class="ds-font-choice" data-font="Lora" aria-label="Lora yazı tipini seç" aria-pressed="false"><span style="font-family:'Lora',serif">Adınız Soyadınız</span><small>Lora</small></button><button class="ds-font-choice" data-font="Great Vibes" aria-label="Great Vibes yazı tipini seç" aria-pressed="false"><span style="font-family:'Great Vibes',serif">Adınız Soyadınız</span><small>Great Vibes</small></button><button class="ds-font-choice" data-font="Playfair Display" aria-label="Playfair Display yazı tipini seç" aria-pressed="false"><span style="font-family:'Playfair Display',serif">Adınız Soyadınız</span><small>Playfair Display</small></button><button class="ds-font-choice" data-font="Cinzel" aria-label="Cinzel yazı tipini seç" aria-pressed="false"><span style="font-family:'Cinzel',serif">Adınız Soyadınız</span><small>Cinzel</small></button><button class="ds-font-choice" data-font="Marcellus" aria-label="Marcellus yazı tipini seç" aria-pressed="false"><span style="font-family:'Marcellus',serif">Adınız Soyadınız</span><small>Marcellus</small></button><button class="ds-font-choice" data-font="Allura" aria-label="Allura yazı tipini seç" aria-pressed="false"><span style="font-family:'Allura',serif">Adınız Soyadınız</span><small>Allura</small></button></div></div><div class="ds-logo-actions"><label class="ds-field"><span>Logo ekle</span><input type="file" data-personal-logo accept="image/png,image/jpeg,image/webp,image/svg+xml" aria-label="Masa isimliğine logo ekle"></label><img class="ds-logo-preview" width="64" height="44" data-personal-logo-preview alt="Eklenen logo" hidden><button class="ds-btn" data-act="remove-logo" hidden>Logoyu kaldır</button></div><p class="ds-personal-note" data-logo-status>PNG, JPG, WEBP veya SVG · en fazla 5 MB</p></div><div class="ds-summary"><h3>Tasarımınız</h3><ul data-summary></ul><div data-product-links></div><p class="ds-personal-note">Aşağıdaki fiyatlar tam setlere aittir; özel parça seçiminizin toplamı değildir.</p><button class="ds-btn" data-act="copy-summary">Tasarım özetini kopyala</button><a class="ds-btn ds-primary" data-quote>Tasarım için teklif iste</a><p class="ds-personal-note">E-posta taslağı açılır. Kaydettiğiniz takım görselini ekleyebilirsiniz; otomatik gönderim yapılmaz.</p><p class="ds-draft-status" data-draft-status>Tasarım yalnızca bu cihazda saklanır.</p><button class="ds-btn" data-act="forget-draft">Cihazdaki taslağı sil</button></div>
