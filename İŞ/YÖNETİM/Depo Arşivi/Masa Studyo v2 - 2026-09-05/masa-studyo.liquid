-top:19px}.ds-link{margin-top:15px}.ds-caption{padding:0 15px 14px;font-size:9px}.is-editing{position:fixed;inset:0;z-index:10000;overflow:auto;height:100dvh;background:var(--ds-paper)}.is-editing .ds-shell{display:flex;height:100%;min-height:0}.is-editing .ds-workspace{flex:none;min-height:0}.is-editing .ds-toolbar{position:sticky;top:0;z-index:150;gap:6px;padding:10px 12px;flex-wrap:nowrap;overflow-x:auto}.ds-toolbar strong{display:none}.ds-toolbar .ds-btn{min-height:40px;padding:9px;font-size:10px}.ds-toolbar .ds-btn svg{width:15px}.ds-toolbar .ds-save{margin-left:auto}.is-editing .ds-viewport{max-height:49dvh;min-height:230px}.is-editing .ds-stage{min-width:100%}.is-editing .ds-caption{padding:7px 14px;font-size:9px}.is-editing .ds-status{padding:0 14px 6px;font-size:10px}.ds-zoom{bottom:59px;right:12px}.ds-zoom button{width:30px;height:30px}.ds-panel{border-left:0;border-top:1px solid var(--ds-line);flex:1;min-height:100px;max-height:none;padding:15px;overflow:auto}.ds-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.ds-card{min-height:97px;padding:10px 5px 7px}.ds-card img{height:48px}.ds-card span{font-size:9px}.ds-card:after{font-size:15px;right:5px}.ds-help{font-size:10px;margin:9px 0}.ds-panel-head{margin-bottom:11px}.ds-selection{margin-bottom:15px;padding-bottom:14px}.ds-selection h3{font-size:25px}.ds-selection-fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.ds-field{margin-top:11px}.ds-field select{min-height:42px;font-size:12px}.ds-color{width:31px;height:31px;padding:3px}.ds-colors{gap:7px}.ds-bottom{margin-top:12px;padding-top:12px}.ds-pieces{margin-top:10px}.ds-dialog{padding:17px}.ds-dialog .ds-actions{flex-wrap:wrap}.ds-dialog h2{font-size:27px}}@media(prefers-reduced-motion:reduce){.ds-piece,.ds-card{animation:none!important;transition:none!important}}
