# Supabase Project Settings > API
SUPABASE_URL=DOLDURULACAK
SUPABASE_PUBLISHABLE_KEY=DOLDURULACAK

# Virgülle ayrılmış, panele girebilecek hesaplar; aynı adresler admin_users tablosunda da olmalı
ADMIN_EMAILS=DOLDURULACAK

# Tekil geliştirici rolüne bağlanacak mevcut yönetici e-posta adresi
DEVELOPER_EMAIL=DOLDURULACAK

# supabase/schema.sql varsayılan olarak bu bucket'ı oluşturur
SUPABASE_STORAGE_BUCKET=product-images

# Google Search Console doğrulama kodu (isteğe bağlı)
GOOGLE_SITE_VERIFICATION=DOLDURULACAK

# Bing/Copilot ve katılımcı arama motorlarına ürün güncellemelerini anlık bildirmek için
INDEXNOW_KEY=DOLDURULACAK
