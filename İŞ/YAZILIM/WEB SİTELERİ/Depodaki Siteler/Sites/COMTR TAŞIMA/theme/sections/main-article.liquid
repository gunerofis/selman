<article class="article-page">
  <header class="article-head">
    <a class="article-back" href="{{ blog.url }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 12H5M10 7l-5 5 5 5"/></svg> Tüm yazılar</a>
    <p class="eyebrow">Masa üstü notları</p>
    <h1>{{ article.title }}</h1>
    <div class="article-meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time>
      <span>•</span>
      <span>{{ article.content | strip_html | size | divided_by: 900 | plus: 2 }} dk okuma</span>
    </div>
  </header>

  <div class="article-cover">
    {% if article.image %}
      {{ article.image | image_url: width: 1800 | image_tag: widths: '720, 1100, 1500, 1800', sizes: '100vw', loading: 'eager', alt: article.image.alt | default: article.title }}
    {% else %}
      <img src="{{ 'story-crystal-1536.webp' | asset_url }}" alt="Özenle düzenlenmiş masa üstü" width="1536" height="1024" loading="eager">
    {% endif %}
    <span aria-hidden="true">S</span>
  </div>

  <div class="article-layout">
    <aside class="article-aside">
      <span>Rehber</span>
      <p>Doğru ürün, sakin bir çalışma alanı ve uzun süreli kullanım için hazırlanan notlar.</p>
      <a href="/pages/bize-ulasin">Sorunuz mu var?</a>
    </aside>
    <div class="article-body rte">{{ article.content }}</div>
  </div>

  {% liquid
    assign related_cat_url = '/collections/sumen-takimi'
    assign related_cat_label = 'Sümen takımı modelleri'
    if article.handle contains 'isimlik'
      assign related_cat_url = '/collections/masa-ustu-isimlikler'
      assign related_cat_label = 'Masaüstü isimlikler'
    elsif article.handle contains 'deri' or article.handle contains 'renk' or article.handle contains 'bakim'
      assign related_cat_url = '/collections/deri-sumen-takimlari'
      assign related_cat_label = 'Deri sümen takımları'
    elsif article.handle contains 'kristal'
      assign related_cat_url = '/collections/kristal-sumen-takimlari'
      assign related_cat_label = 'Kristal sümen takımları'
    elsif article.handle contains 'parca'
      assign related_cat_url = '/collections/sumen-takimi'
      assign related_cat_label = 'Sümen takımı modelleri'
    elsif article.handle contains 'yonetici'
      assign related_cat_url = '/collections/luks-sumen-takimlari'
      assign related_cat_label = 'Lüks sümen takımları'
    endif
  %}
  <footer class="article-footer">
    <p class="eyebrow">Sonraki adım</p>
    <h2>Masadaki ayrıntılar, çalışma biçiminizi değiştirir.</h2>
    <div>
      <a class="button button-dark" href="{{ related_cat_url }}">{{ related_cat_label }} <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M14 7l5 5-5 5"/></svg></a>
      <a class="text-link" href="/pages/sumen-takimi-rehberi">Sümen takımı rehberi</a>
      <a class="text-link" href="/pages/sss">Sık sorulan sorular</a>
      <a class="text-link" href="{{ blog.url }}">Diğer yazılar</a>
    </div>
  </footer>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | strip | truncate: 300 | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
  "inLanguage": "tr-TR",
  "mainEntityOfPage": {{ request.origin | append: article.url | json }},
  {% if article.image %}
  "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
  {% endif %}
  "author": { "@type": "Organization", "name": "Sümen Takımı" },
  "publisher": { "@type": "Organization", "name": "Sümen Takımı" }
}
</script>

{% schema %}
{
  "name": "Blog yazısı",
  "settings": []
}
{% endschema %}
