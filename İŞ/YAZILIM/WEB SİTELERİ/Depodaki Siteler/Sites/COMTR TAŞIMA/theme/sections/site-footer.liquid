<footer class="site-footer">
  <div class="footer-main">
    <a class="footer-brand" href="{{ routes.root_url }}">Sümen Takımı</a>
    <div class="footer-group">
      <h2>Kategoriler</h2>
      <a href="/collections/sumen-takimi">Sümen takımı modelleri</a>
      <a href="/collections/deri-sumen-takimlari">Deri sümen takımları</a>
      <a href="/collections/masa-ustu-isimlikler">Masa üstü isimlikler</a>
      <a href="/collections/makam-panolari">Makam panoları</a>
      <a href="/pages/sumen-takimi-rehberi">Sümen takımı rehberi</a>
    </div>
    <div class="footer-group">
      <h2>Kurumsal</h2>
      <a href="/pages/hakkimizda">Hakkımızda ve üretim</a>
      <a href="{{ shop.privacy_policy.url | default: '/pages/gizlilik-sozlesmesi' }}">Gizlilik</a>
      <a href="{{ shop.terms_of_service.url | default: '/pages/kullanim-kosullari' }}">Kullanım koşulları</a>
      <a href="/pages/mesafeli-satis-sozlesmesi">Mesafeli satış</a>
    </div>
    <div class="footer-group">
      <h2>Destek</h2>
      <a href="/pages/sss">Sık sorulan sorular</a>
      <a href="{{ shop.refund_policy.url | default: '/pages/teslimat-ve-iade-sozlesmesi' }}">Teslimat ve iade</a>
      <a href="/pages/bize-ulasin">İletişim</a>
    </div>
    <address class="footer-contact">
      {% if settings.contact_phone != blank %}
        <a href="tel:{{ settings.contact_phone | remove: ' ' }}">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8.2 4.5 10 8l-2 1.8c1.3 2.7 3.5 4.9 6.2 6.2l1.8-2 3.5 1.8c.4.2.6.6.5 1-.5 2-2.2 3.4-4.3 3.2C9.6 19.3 4.7 14.4 4 8.3 3.8 6.2 5.2 4.5 7.2 4c.4-.1.8.1 1 .5Z"/></svg>
          <span>{{ settings.contact_phone }}</span>
        </a>
      {% endif %}
      {% if settings.contact_email != blank %}
        <a href="mailto:{{ settings.contact_email }}">
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m4 7 8 6 8-6"/></svg>
          <span>{{ settings.contact_email }}</span>
        </a>
      {% endif %}
      {% if settings.contact_address != blank %}
        <span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
          <span>{{ settings.contact_address }}</span>
        </span>
      {% endif %}
    </address>
  </div>
  <div class="footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} Sümen Takımı</span>
    <button type="button" class="cookie-settings-trigger">Çerez tercihleri <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M14 7l5 5-5 5"/></svg></button>
  </div>
</footer>

<aside class="cookie-banner" aria-labelledby="cookie-banner-title" hidden>
  <div>
    <h2 id="cookie-banner-title">Çerez tercihleri</h2>
    <p>Zorunlu çerezler mağaza işlevleri için kullanılır. Analitik çerezler yalnız izninizle etkinleştirilir.</p>
  </div>
  <div class="cookie-actions">
    <button class="button button-outline cookie-reject" type="button">Yalnız gerekli</button>
    <button class="button button-dark cookie-accept" type="button">Tümünü kabul et</button>
    <button class="text-link cookie-customize" type="button">Tercihleri yönet</button>
  </div>
</aside>

<dialog class="cookie-dialog" aria-labelledby="cookie-dialog-title">
  <div class="sheet-head">
    <h2 id="cookie-dialog-title">Çerez tercihleri</h2>
    <button class="dialog-close" type="button" aria-label="Çerez tercihlerini kapat"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"/></svg></button>
  </div>
  <p>Tercihinizi daha sonra bu alandan değiştirebilirsiniz.</p>
  <label class="consent-row">
    <span><strong>Zorunlu</strong><small>Temel mağaza işlevleri ve tercih kaydı.</small></span>
    <input type="checkbox" checked disabled aria-label="Zorunlu çerezler her zaman açık">
  </label>
  <label class="consent-row">
    <span><strong>Analitik</strong><small>Site kullanımını ölçmek için; varsayılan olarak kapalı.</small></span>
    <input class="analytics-consent" type="checkbox" aria-label="Analitik çerezlere izin ver">
  </label>
  <button class="button button-dark cookie-save" type="button">Tercihleri kaydet</button>
</dialog>

<dialog class="sheet cart-drawer" id="CartDrawer" aria-labelledby="cart-drawer-title" data-money-format="{{ shop.money_format | escape }}">
  <div class="sheet-head">
    <h2 id="cart-drawer-title">Sepet</h2>
    <button class="dialog-close" type="button" aria-label="Sepeti kapat"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"/></svg></button>
  </div>
  <div class="cart-drawer__body" data-cart-drawer-body>
    <p data-cart-empty>Sepetiniz henüz boş.</p>
    <nav class="cart-drawer__empty-links" data-cart-empty-links aria-label="Koleksiyonlar">
      <a href="/collections/deri-sumen-takimlari">Deri sümen takımları</a>
      <a href="/collections/kristal-sumen-takimlari">Kristal sümen takımları</a>
      <a href="/collections/masa-ustu-isimlikler">Masa üstü isimlikler</a>
      <a href="/collections/makam-panolari">Makam panoları</a>
    </nav>
    <div class="cart-drawer__lines" data-cart-lines hidden></div>
  </div>
  <div class="cart-drawer__foot" data-cart-drawer-foot hidden>
    <p>Ara toplam <strong data-cart-subtotal></strong></p>
    <p class="cart-shipping-note">Kargo ücreti ödeme adımında hesaplanır. Siparişler Gebze ve İstanbul depolarından çıkar. <a href="{{ shop.refund_policy.url | default: shop.shipping_policy.url }}">Teslimat ve iade</a></p>
    <a class="button button-outline" href="{{ routes.cart_url }}">Sepeti görüntüle</a>
    <a class="button button-dark" href="/checkout">Ödemeye geç</a>
  </div>
</dialog>

{% schema %}
{
  "name": "Site alt alanı",
  "settings": []
}
{% endschema %}
