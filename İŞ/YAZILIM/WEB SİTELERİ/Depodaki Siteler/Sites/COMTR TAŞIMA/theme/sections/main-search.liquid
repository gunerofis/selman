<section class="generic-page catalog-page">
  <header class="catalog-head">
    <p class="eyebrow">Arama</p>
    <h1>{% if search.performed %}“{{ search.terms | escape }}” için sonuçlar{% else %}Ürün ara{% endif %}</h1>
    <form class="page-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchPageInput">Ürün ara</label>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Ürün adı veya kategori">
      <input type="hidden" name="type" value="product">
      <button class="button button-dark" type="submit">Ara</button>
    </form>
  </header>
  {% if search.performed %}
    {% paginate search.results by 24 %}
      <div class="catalog-grid home-board">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}
        {% else %}
          <div class="search-empty">
            <p>Aramanızla eşleşen ürün bulunamadı.</p>
            <p>Koleksiyonlardan devam edebilirsiniz:</p>
            <p>
              <a class="text-link" href="/collections/sumen-takimi">Tüm sümen takımları</a>
              <a class="text-link" href="/collections/deri-sumen-takimlari">Deri sümen takımları</a>
              <a class="text-link" href="/collections/kristal-sumen-takimlari">Kristal sümen takımları</a>
              <a class="text-link" href="/collections/masa-ustu-isimlikler">Masa üstü isimlikler</a>
            </p>
          </div>
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{ "name": "Arama", "settings": [] }
{% endschema %}
